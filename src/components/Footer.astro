---
const currentYear = new Date().getFullYear();
---

<footer class="bg-gray-900 border-t border-white/5" aria-labelledby="footer-heading">
  <h2 id="footer-heading" class="sr-only">Footer</h2>
  <div class="mx-auto max-w-7xl px-6 pb-8 pt-16 sm:pt-24 lg:px-8 lg:pt-32">
    <div class="xl:grid xl:grid-cols-4 xl:gap-8">
      {/* Brand Section */}
      <div class="space-y-8">
        <a href="/" class="flex items-center gap-2 group">
          <div class="h-10 w-10 rounded-xl bg-blue-600 flex items-center justify-center shadow-lg shadow-blue-600/20 group-hover:scale-110 transition-transform duration-300">
            <svg class="w-6 h-6 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
            </svg>
          </div>
          <span class="text-2xl font-bold text-white tracking-tight">SELL EVERYDAY</span>
        </a>
        <p class="text-sm leading-6 text-gray-400 max-w-xs">
          Empowering modern retail with offline-first technology. Run your business anywhere, anytime, without limits.
        </p>
        <div class="flex space-x-5">
          <a href="#" class="text-gray-400 hover:text-white transition-colors duration-300">
            <span class="sr-only">Facebook</span>
            <svg class="h-6 w-6" fill="currentColor" viewBox="0 0 24 24"><path d="M22 12c0-5.523-4.477-10-10-10S2 6.477 2 12c0 4.991 3.657 9.128 8.438 9.878v-6.987h-2.54V12h2.54V9.797c0-2.506 1.492-3.89 3.777-3.89 1.094 0 2.238.195 2.238.195v2.46h-1.26c-1.243 0-1.63.771-1.63 1.562V12h2.773l-.443 2.89h-2.33v6.988C18.343 21.128 22 16.991 22 12z"/></svg>
          </a>
          <a href="#" class="text-gray-400 hover:text-white transition-colors duration-300">
            <span class="sr-only">Instagram</span>
            <svg class="h-6 w-6" fill="currentColor" viewBox="0 0 24 24"><path d="M12.315 2c2.43 0 2.784.013 3.808.06 1.064.049 1.791.218 2.427.465a4.902 4.902 0 011.772 1.153 4.902 4.902 0 011.153 1.772c.247.636.416 1.363.465 2.427.048 1.067.06 1.407.06 4.123v.08c0 2.643-.012 2.987-.06 4.043-.049 1.064-.218 1.791-.465 2.427a4.902 4.902 0 01-1.153 1.772 4.902 4.902 0 01-1.772 1.153c-.636.247-1.363.416-2.427.465-1.067.048-1.407.06-4.123.06h-.08c-2.643 0-2.987-.012-4.043-.06-1.064-.049-1.791-.218-2.427-.465a4.902 4.902 0 01-1.772-1.153 4.902 4.902 0 01-1.153-1.772c-.247-.636-.416-1.363-.465-2.427-.047-1.024-.06-1.379-.06-3.808v-.63c0-2.43.013-2.784.06-3.808.049-1.064.218-1.791.465-2.427a4.902 4.902 0 011.153-1.772A4.902 4.902 0 015.45 2.525c.636-.247 1.363-.416 2.427-.465C8.901 2.013 9.256 2 11.685 2h.63zm-.081 1.802h-.468c-2.456 0-2.784.011-3.807.058-.975.045-1.504.207-1.857.344-.467.182-.8.398-1.15.748-.35.35-.566.683-.748 1.15-.137.353-.3.882-.344 1.857-.047 1.023-.058 1.351-.058 3.807v.468c0 2.456.011 2.784.058 3.807.045.975.207 1.504.344 1.857.182.466.399.8.748 1.15.35.35.683.566 1.15.748.353.137.882.3 1.857.344 1.054.048 1.37.058 4.041.058h.08c2.597 0 2.917-.01 3.96-.058.976-.045 1.505-.207 1.858-.344.466-.182.8-.398 1.15-.748.35-.35.566-.683.748-1.15.137-.353.3-.882.344-1.857.048-1.055.058-1.37.058-4.041v-.08c0-2.597-.01-2.917-.058-3.96-.045-.976-.207-1.505-.344-1.858a3.097 3.097 0 00-.748-1.15 3.098 3.098 0 00-1.15-.748c-.353-.137-.882-.3-1.857-.344-1.023-.047-1.351-.058-3.807-.058zM12 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16.4a4.4 4.4 0 110-8.8 4.4 4.4 0 010 8.8zm6.487-11.59a1.44 1.44 0 11-2.88 0 1.44 1.44 0 012.88 0z"/></svg>
          </a>
          <a href="#" class="text-gray-400 hover:text-white transition-colors duration-300">
            <span class="sr-only">X (Twitter)</span>
            <svg class="h-6 w-6" fill="currentColor" viewBox="0 0 24 24"><path d="M13.6823 10.6218L20.2391 3H18.6854L12.9921 9.61788L8.44486 3H3.2002L10.0765 13.0074L3.2002 21H4.75404L10.7663 14.0113L15.5685 21H20.8131L13.6819 10.6218H13.6823ZM11.5541 13.0956L10.8574 12.0991L5.31398 4.16971H7.70053L12.1742 10.5689L12.8709 11.5655L18.6861 19.8835H16.2995L11.5541 13.096V13.0956Z"/></svg>
          </a>
        </div>
      </div>

      {/* Navigation Links */}
      <div class="mt-16 grid grid-cols-2 gap-8 xl:col-span-2 xl:mt-0">
        <div class="md:grid md:grid-cols-2 md:gap-8">
          <div>
            <h3 class="text-sm font-bold leading-6 text-white uppercase tracking-wider">Product</h3>
            <ul role="list" class="mt-6 space-y-4">
              <li><a href="/features" class="text-sm leading-6 text-gray-400 hover:text-blue-400 transition-colors duration-200">Features</a></li>
              <li><a href="/pricing" class="text-sm leading-6 text-gray-400 hover:text-blue-400 transition-colors duration-200">Pricing</a></li>
              <li><a href="/download" class="text-sm leading-6 text-gray-400 hover:text-blue-400 transition-colors duration-200">Download Apps</a></li>
              <li><a href="/demo" class="text-sm leading-6 text-gray-400 hover:text-blue-400 transition-colors duration-200">Watch Demo</a></li>
            </ul>
          </div>
          <div class="mt-10 md:mt-0">
            <h3 class="text-sm font-bold leading-6 text-white uppercase tracking-wider">Company</h3>
            <ul role="list" class="mt-6 space-y-4">
              <li><a href="/about" class="text-sm leading-6 text-gray-400 hover:text-blue-400 transition-colors duration-200">About Us</a></li>
              <li><a href="/blog" class="text-sm leading-6 text-gray-400 hover:text-blue-400 transition-colors duration-200">Blog</a></li>
              <li><a href="#" class="text-sm leading-6 text-gray-400 hover:text-blue-400 transition-colors duration-200">Careers</a></li>
              <li><a href="#" class="text-sm leading-6 text-gray-400 hover:text-blue-400 transition-colors duration-200">Privacy Policy</a></li>
            </ul>
          </div>
        </div>
      </div>

      {/* Contact Section */}
      <div class="mt-10 xl:mt-0">
        <h3 class="text-sm font-bold leading-6 text-white uppercase tracking-wider">Contact & Support</h3>
        <ul role="list" class="mt-6 space-y-4">
          <li class="flex items-center gap-3 text-sm text-gray-400">
            <svg class="h-5 w-5 text-blue-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
            </svg>
            <a href="mailto:support@selleveryday.com" class="hover:text-blue-400 transition-colors">support@selleveryday.com</a>
          </li>
          <li class="flex items-center gap-3 text-sm text-gray-400">
            <svg class="h-5 w-5 text-blue-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
            </svg>
            <a href="tel:+234800000000" class="hover:text-blue-400 transition-colors">+234 800 SELL EVERYDAY</a>
          </li>
          <li class="pt-4">
            <a href="https://app.sell-everyday-pos.app/register" class="inline-flex items-center px-4 py-2 rounded-lg bg-blue-600/10 text-blue-400 text-sm font-bold border border-blue-600/20 hover:bg-blue-600 hover:text-white transition-all duration-300">
              Get Started Free
            </a>
          </li>
        </ul>
      </div>
    </div>

    {/* Bottom Section */}
    <div class="mt-16 border-t border-white/5 pt-8 flex flex-col md:flex-row justify-between items-center gap-4">
      <p class="text-xs leading-5 text-gray-500">
        &copy; {currentYear} Everyday Intelligence. All rights reserved. Built with ❤️ for retail owners.
      </p>
      <div class="flex items-center gap-6">
        <span class="inline-flex items-center px-2 py-1 rounded-full bg-green-500/10 text-[10px] font-bold text-green-500 uppercase tracking-tight border border-green-500/20">
          <span class="h-1 w-1 rounded-full bg-green-500 mr-1.5 animate-pulse"></span>
          Systems Operational
        </span>
      </div>
    </div>
  </div>
</footer>
