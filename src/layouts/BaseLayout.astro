---
// PRODUCTION SAFEGUARDS:
// 1. Strict Typing: Enforces that every page MUST provide SEO metadata.
// 2. Canonical URLs: Prevents duplicate content penalties from Google.
// 3. OpenGraph/Twitter Cards: Ensures the site looks professional when shared on social media/WhatsApp.
import '../styles/global.css';
interface Props {
  title: string;
  description: string;
  image?: string;
  canonicalURL?: string | URL;
  type?: 'website' | 'article';
}

const {
  title,
  description,
  image = '/images/default-og-image.jpg', // Fallback social image
  canonicalURL = new URL(Astro.url.pathname, Astro.site || Astro.url.origin),
  type = 'website',
} = Astro.props;

// Ensure title is suffixed with the brand name for consistency
const formattedTitle = `${title} | EI POS System`;
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <!-- Primary Meta Tags -->
    <title>{formattedTitle}</title>
    <meta name="title" content={formattedTitle} />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={formattedTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(image, Astro.site)} />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={formattedTitle} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={new URL(image, Astro.site)} />

    <!-- Sitemap (Generated by @astrojs/sitemap) -->
    <link rel="sitemap" href="/sitemap-index.xml" />
    
    <!-- Fonts (Preloaded for performance) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  </head>
  <body class="bg-gray-50 text-gray-900 antialiased flex flex-col min-h-screen">
    {/* Navigation Component would go here */}
    
    <main class="flex-grow">
      <slot />
    </main>

    {/* Footer Component would go here */}
  </body>
</html>