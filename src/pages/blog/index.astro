---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

// Fetch all blog posts, excluding drafts
const allPosts = await getCollection('blog', ({ data }) => {
  return data.isDraft !== true;
});

// Sort posts by newest first
const sortedPosts = allPosts.sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf());

const title = "SELL EVERYDAY Blog | Retail Insights & Updates";
const description = "Learn how to scale your retail business, manage multi-branch inventory, and implement offline-first systems.";
---

<BaseLayout title={title} description={description}>
  {/* Header Navigation */}

  <main class="py-24 sm:py-32">
    <div class="mx-auto max-w-7xl px-6 lg:px-8">
      <div class="mx-auto max-w-2xl text-center">
        <h1 class="text-3xl font-bold tracking-tight text-gray-900 sm:text-4xl">The Retail Command Center</h1>
        <p class="mt-2 text-lg leading-8 text-gray-600">Actionable advice for scaling your multi-branch empire.</p>
      </div>

      <div class="mx-auto mt-16 grid max-w-2xl grid-cols-1 gap-x-8 gap-y-20 lg:mx-0 lg:max-w-none lg:grid-cols-3">
        {sortedPosts.length === 0 ? (
           <p class="text-gray-500 italic col-span-3 text-center">No posts published yet. Check back soon!</p>
        ) : (
          sortedPosts.map(post => (
            <article class="flex flex-col items-start justify-between bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden hover:shadow-md transition-shadow">
              <a href={`/blog/${post.id}`} class="w-full">
                <img 
                  src={post.data.coverImage.src} 
                  alt={post.data.coverImageAlt} 
                  class="aspect-[16/9] w-full object-cover bg-gray-100 sm:aspect-[2/1] lg:aspect-[3/2]" 
                />
              </a>
              <div class="p-6">
                <div class="flex items-center gap-x-4 text-xs">
                  <time datetime={post.data.publishDate.toISOString()} class="text-gray-500">
                    {post.data.publishDate.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}
                  </time>
                  <span class="relative z-10 rounded-full bg-blue-50 px-3 py-1.5 font-medium text-blue-600">
                    {post.data.tags[0]}
                  </span>
                </div>
                <div class="group relative">
                  <h3 class="mt-3 text-lg font-semibold leading-6 text-gray-900 group-hover:text-blue-600 transition-colors">
                    <a href={`/blog/${post.id}`}>
                      <span class="absolute inset-0"></span>
                      {post.data.title}
                    </a>
                  </h3>
                  <p class="mt-5 line-clamp-3 text-sm leading-6 text-gray-600">{post.data.description}</p>
                </div>
                <div class="relative mt-6 flex items-center gap-x-4">
                  <div class="text-sm leading-6">
                    <p class="font-semibold text-gray-900">
                      <span class="absolute inset-0"></span>
                      {post.data.author}
                    </p>
                  </div>
                </div>
              </div>
            </article>
          ))
        )}
      </div>
    </div>
    </div>

    {/* --- FOOTER --- */}

  </main>
</BaseLayout>


