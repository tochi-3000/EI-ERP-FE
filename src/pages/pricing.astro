---
import BaseLayout from '../layouts/BaseLayout.astro';
import CheckIcon from '../components/CheckIcon.astro';

const title = "Pricing | EI POS";
const description = "Simple, transparent pricing for retail businesses of all sizes. Choose from Mini, Growth, Boss, Scale, or Enterprise plans.";
---

<BaseLayout title={title} description={description}>
  {/* Header */}
  <header class="absolute inset-x-0 top-0 z-50">
    <nav class="mx-auto flex max-w-7xl items-center justify-between p-6 lg:px-8" aria-label="Global">
      <div class="flex lg:flex-1">
        <a href="/" class="-m-1.5 p-1.5 flex items-center gap-2">
          <div class="h-8 w-8 rounded bg-blue-600 flex items-center justify-center">
            <svg class="w-5 h-5 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" /></svg>
          </div>
          <span class="font-bold text-xl tracking-tight text-gray-900">EI POS</span>
        </a>
      </div>
      <div class="hidden lg:flex lg:gap-x-12">
        <a href="/features" class="text-sm font-semibold leading-6 text-gray-900 hover:text-blue-600 transition">Features</a>
        <a href="/pricing" class="text-sm font-semibold leading-6 text-blue-600">Pricing</a>
        <a href="/blog" class="text-sm font-semibold leading-6 text-gray-900 hover:text-blue-600 transition">Blog</a>
      </div>
      <div class="hidden lg:flex lg:flex-1 lg:justify-end lg:gap-x-4">
        <a href="https://app.yourdomain.com/login" class="text-sm font-semibold leading-6 text-gray-900 hover:text-blue-600 py-2">Log in</a>
        <a href="https://app.yourdomain.com/signup" class="rounded-lg bg-blue-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-blue-500 transition">Get Started</a>
      </div>
    </nav>
  </header>

  <main class="py-24 sm:py-32 bg-gray-50 min-h-screen">
    <div class="mx-auto max-w-7xl px-6 lg:px-8">
      
      {/* Title Section */}
      <div class="mx-auto max-w-4xl text-center">
        <h1 class="text-base font-semibold leading-7 text-blue-600">Pricing</h1>
        <p class="mt-2 text-4xl font-bold tracking-tight text-gray-900 sm:text-5xl">
          Pricing that scales with your retail empire.
        </p>
        <p class="mx-auto mt-6 max-w-2xl text-center text-lg leading-8 text-gray-600">
          Start with a 14-day free trial on any plan. No credit card required. Cancel or change plans anytime.
        </p>
      </div>

      {/* Monthly / Yearly Toggle */}
      <div class="mt-12 flex justify-center items-center gap-4">
        <span class="text-sm font-bold text-gray-900" id="label-monthly">Monthly</span>
        <button 
          type="button" 
          id="billing-toggle" 
          class="relative inline-flex h-7 w-12 flex-shrink-0 cursor-pointer rounded-full border-2 border-transparent bg-gray-300 transition-colors duration-200 ease-in-out focus:outline-none shadow-inner"
        >
          <span id="toggle-circle" class="pointer-events-none inline-block h-6 w-6 translate-x-0 transform rounded-full bg-white shadow ring-0 transition duration-200 ease-in-out"></span>
        </button>
        <span class="text-sm font-semibold text-gray-500 flex items-center gap-2" id="label-yearly">
          Yearly 
          <span class="text-[10px] font-bold bg-green-100 text-green-700 px-2 py-0.5 rounded-full uppercase tracking-wide">Save up to 15%</span>
        </span>
      </div>

      {/* --- PRICING GRID (4 TIERS) --- */}
      <div class="isolate mx-auto mt-12 grid max-w-md grid-cols-1 gap-6 sm:mt-16 lg:max-w-none lg:grid-cols-4">
        
        {/* Tier 1: Mini */}
        <div class="rounded-3xl p-8 ring-1 ring-gray-200 bg-white shadow-sm flex flex-col justify-between hover:shadow-lg transition-shadow">
          <div>
            <h3 class="text-lg font-bold leading-8 text-gray-900">Mini</h3>
            <p class="mt-2 text-sm leading-6 text-gray-500">Perfect for single-location kiosks getting started.</p>
            <p class="mt-6 flex items-baseline gap-x-1">
              <span class="text-4xl font-extrabold tracking-tight text-gray-900">₦<span class="price-val" data-monthly="3,000" data-yearly="30,000">3,000</span></span>
              <span class="text-sm font-semibold leading-6 text-gray-500 price-period">/mo</span>
            </p>
            <ul role="list" class="mt-8 space-y-3 text-sm leading-6 text-gray-700 font-medium">
              <li class="flex gap-x-3"><CheckIcon /> 1 Branch</li>
              <li class="flex gap-x-3"><CheckIcon /> 3 Staff Members</li>
              <li class="flex gap-x-3"><CheckIcon /> 70 Products</li>
              <li class="flex gap-x-3"><CheckIcon /> 50 AI Chats / day</li>
            </ul>
          </div>
          <a href="https://app.yourdomain.com/signup" class="mt-8 block w-full rounded-lg px-3 py-2.5 text-center text-sm font-semibold leading-6 text-blue-600 ring-1 ring-inset ring-blue-200 hover:ring-blue-300 hover:bg-blue-50 transition-colors">Start Free Trial</a>
        </div>

        {/* Tier 2: Growth */}
        <div class="rounded-3xl p-8 ring-1 ring-gray-200 bg-white shadow-sm flex flex-col justify-between hover:shadow-lg transition-shadow">
          <div>
            <h3 class="text-lg font-bold leading-8 text-gray-900">Growth</h3>
            <p class="mt-2 text-sm leading-6 text-gray-500">For expanding businesses opening new branches.</p>
            <p class="mt-6 flex items-baseline gap-x-1">
              <span class="text-4xl font-extrabold tracking-tight text-gray-900">₦<span class="price-val" data-monthly="7,000" data-yearly="75,000">7,000</span></span>
              <span class="text-sm font-semibold leading-6 text-gray-500 price-period">/mo</span>
            </p>
            <ul role="list" class="mt-8 space-y-3 text-sm leading-6 text-gray-700 font-medium">
              <li class="flex gap-x-3"><CheckIcon /> 3 Branches</li>
              <li class="flex gap-x-3"><CheckIcon /> 15 Staff Members</li>
              <li class="flex gap-x-3"><CheckIcon /> 150 Products</li>
              <li class="flex gap-x-3"><CheckIcon /> 150 AI Chats / day</li>
            </ul>
          </div>
          <a href="https://app.yourdomain.com/signup" class="mt-8 block w-full rounded-lg px-3 py-2.5 text-center text-sm font-semibold leading-6 text-blue-600 ring-1 ring-inset ring-blue-200 hover:ring-blue-300 hover:bg-blue-50 transition-colors">Start Free Trial</a>
        </div>

        {/* Tier 3: Boss (Most Popular) */}
        <div class="rounded-3xl p-8 ring-2 ring-blue-600 bg-white shadow-xl flex flex-col justify-between relative transform lg:-translate-y-4">
          <div class="absolute top-0 right-6 -translate-y-1/2 transform rounded-full bg-gradient-to-r from-blue-600 to-blue-500 px-3 py-1 text-xs font-bold leading-5 text-white shadow-sm uppercase tracking-wider">
            Most Popular
          </div>
          <div>
            <h3 class="text-lg font-bold leading-8 text-blue-600">Boss</h3>
            <p class="mt-2 text-sm leading-6 text-gray-500">The sweet spot for established retail operations.</p>
            <p class="mt-6 flex items-baseline gap-x-1">
              <span class="text-4xl font-extrabold tracking-tight text-gray-900">₦<span class="price-val" data-monthly="11,000" data-yearly="110,000">11,000</span></span>
              <span class="text-sm font-semibold leading-6 text-gray-500 price-period">/mo</span>
            </p>
            <ul role="list" class="mt-8 space-y-3 text-sm leading-6 text-gray-900 font-bold">
              <li class="flex gap-x-3"><CheckIcon /> 5 Branches</li>
              <li class="flex gap-x-3"><CheckIcon /> 15 Staff Members</li>
              <li class="flex gap-x-3 text-blue-700"><CheckIcon /> Unlimited Products</li>
              <li class="flex gap-x-3"><CheckIcon /> 250 AI Chats / day</li>
            </ul>
          </div>
          <a href="https://app.yourdomain.com/signup" class="mt-8 block w-full rounded-lg bg-blue-600 px-3 py-3 text-center text-sm font-bold leading-6 text-white shadow-md hover:bg-blue-700 hover:shadow-lg transition-all active:scale-95">Start 14-Day Free Trial</a>
        </div>

        {/* Tier 4: Scale */}
        <div class="rounded-3xl p-8 ring-1 ring-gray-200 bg-white shadow-sm flex flex-col justify-between hover:shadow-lg transition-shadow">
          <div>
            <h3 class="text-lg font-bold leading-8 text-gray-900">Scale</h3>
            <p class="mt-2 text-sm leading-6 text-gray-500">For high-volume chains that need maximum power.</p>
            <p class="mt-6 flex items-baseline gap-x-1">
              <span class="text-4xl font-extrabold tracking-tight text-gray-900">₦<span class="price-val" data-monthly="15,000" data-yearly="130,000">15,000</span></span>
              <span class="text-sm font-semibold leading-6 text-gray-500 price-period">/mo</span>
            </p>
            <ul role="list" class="mt-8 space-y-3 text-sm leading-6 text-gray-700 font-medium">
              <li class="flex gap-x-3"><CheckIcon /> 10 Branches</li>
              <li class="flex gap-x-3"><CheckIcon /> 40 Staff Members</li>
              <li class="flex gap-x-3 text-blue-700"><CheckIcon /> Unlimited Products</li>
              <li class="flex gap-x-3"><CheckIcon /> 500 AI Chats / day</li>
            </ul>
          </div>
          <a href="https://app.yourdomain.com/signup" class="mt-8 block w-full rounded-lg px-3 py-2.5 text-center text-sm font-semibold leading-6 text-blue-600 ring-1 ring-inset ring-blue-200 hover:ring-blue-300 hover:bg-blue-50 transition-colors">Start Free Trial</a>
        </div>
      </div>

      {/* --- ENTERPRISE BANNER --- */}
      <div class="mx-auto mt-12 max-w-7xl rounded-3xl bg-gray-900 px-6 py-10 sm:py-12 lg:flex lg:items-center lg:justify-between lg:px-16 shadow-xl">
         <div>
            <h3 class="text-2xl font-bold tracking-tight text-white sm:text-3xl">Enterprise</h3>
            <p class="mt-2 text-lg leading-8 text-gray-300">
               Need more than 10 branches? We build solutions tailored specifically to your needs, including custom data sovereignty, local server hosting, and SLA agreements.
            </p>
         </div>
         <div class="mt-8 flex items-center gap-x-6 lg:mt-0 lg:flex-shrink-0">
            <a href="mailto:sales@eipayson.com" class="rounded-xl bg-white px-8 py-3.5 text-sm font-bold text-gray-900 shadow-sm hover:bg-gray-100 transition-colors">Contact Sales Support</a>
         </div>
      </div>

      {/* --- ALL FEATURES INCLUDED SECTION --- */}
      <div class="mx-auto mt-32 max-w-7xl">
        <div class="text-center mb-16">
          <h2 class="text-3xl font-bold tracking-tight text-gray-900 sm:text-4xl">Everything you need, included in all plans.</h2>
          <p class="mt-4 text-lg text-gray-500">We don't paywall essential tools. Choose your tier based on your volume, not your required feature set.</p>
        </div>
        
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-x-8 gap-y-12">
           {/* Feature Item */}
           <div class="flex gap-4">
              <div class="h-10 w-10 flex items-center justify-center rounded-lg bg-blue-100 text-blue-600 shrink-0">
                <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z" /></svg>
              </div>
              <div>
                 <h3 class="text-base font-bold text-gray-900">Mobile App & Scanner</h3>
                 <p class="mt-2 text-sm text-gray-600">Sell directly via the mobile app and use your device camera as a lightning-fast barcode scanner.</p>
              </div>
           </div>

           <div class="flex gap-4">
              <div class="h-10 w-10 flex items-center justify-center rounded-lg bg-purple-100 text-purple-600 shrink-0">
                <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" /></svg>
              </div>
              <div>
                 <h3 class="text-base font-bold text-gray-900">Store AI Assistant</h3>
                 <p class="mt-2 text-sm text-gray-600">Ask natural language questions about your sales, pull insights, and even create products instantly.</p>
              </div>
           </div>

           <div class="flex gap-4">
              <div class="h-10 w-10 flex items-center justify-center rounded-lg bg-indigo-100 text-indigo-600 shrink-0">
                <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" /></svg>
              </div>
              <div>
                 <h3 class="text-base font-bold text-gray-900">Multi-Branch Control</h3>
                 <p class="mt-2 text-sm text-gray-600">Single branch management for managers, and full top-down organizational control for the admin/owner.</p>
              </div>
           </div>

           <div class="flex gap-4">
              <div class="h-10 w-10 flex items-center justify-center rounded-lg bg-green-100 text-green-600 shrink-0">
                <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg>
              </div>
              <div>
                 <h3 class="text-base font-bold text-gray-900">Hybrid Checkout</h3>
                 <p class="mt-2 text-sm text-gray-600">Process offline and online sales seamlessly. Fully supports VAT, Service Charges, Coupons, and Delivery logic.</p>
              </div>
           </div>

           <div class="flex gap-4">
              <div class="h-10 w-10 flex items-center justify-center rounded-lg bg-orange-100 text-orange-600 shrink-0">
                <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4" /></svg>
              </div>
              <div>
                 <h3 class="text-base font-bold text-gray-900">Inventory Ecosystem</h3>
                 <p class="mt-2 text-sm text-gray-600">Track inter-store transfers, manage suppliers, and automate purchase orders with weighted average costs.</p>
              </div>
           </div>

           <div class="flex gap-4">
              <div class="h-10 w-10 flex items-center justify-center rounded-lg bg-pink-100 text-pink-600 shrink-0">
                <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0z" /></svg>
              </div>
              <div>
                 <h3 class="text-base font-bold text-gray-900">CRM & Loyalty</h3>
                 <p class="mt-2 text-sm text-gray-600">Create customers, track purchase history, manage credit/debt ledgers, and run a points-based reward system.</p>
              </div>
           </div>

           <div class="flex gap-4">
              <div class="h-10 w-10 flex items-center justify-center rounded-lg bg-red-100 text-red-600 shrink-0">
                <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 14l6-6m-5.5.5h.01m4.99 5h.01M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16l3.5-2 3.5 2 3.5-2 3.5 2z" /></svg>
              </div>
              <div>
                 <h3 class="text-base font-bold text-gray-900">Expense Tracking</h3>
                 <p class="mt-2 text-sm text-gray-600">Log recurring bills and one-time operational expenses directly against your P&L reports.</p>
              </div>
           </div>

           <div class="flex gap-4">
              <div class="h-10 w-10 flex items-center justify-center rounded-lg bg-teal-100 text-teal-600 shrink-0">
                <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H4a2 2 0 00-2 2v6a2 2 0 002 2h3a2 2 0 002-2zm0 0V9a2 2 0 012-2h3a2 2 0 012 2v10m-2 0h2a2 2 0 002-2V9a2 2 0 00-2-2h-3a2 2 0 00-2 2v10a2 2 0 002 2z" /></svg>
              </div>
              <div>
                 <h3 class="text-base font-bold text-gray-900">Advanced Analytics</h3>
                 <p class="mt-2 text-sm text-gray-600">View your best-performing goods, employees, stores, and customers. Get automated low-stock reminders.</p>
              </div>
           </div>

           <div class="flex gap-4">
              <div class="h-10 w-10 flex items-center justify-center rounded-lg bg-gray-800 text-white shrink-0">
                <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" /></svg>
              </div>
              <div>
                 <h3 class="text-base font-bold text-gray-900">Anti-Theft Auditing</h3>
                 <p class="mt-2 text-sm text-gray-600">Receive alerts for fraudulent price overrides and track every manual quantity adjustment in a secure ledger.</p>
              </div>
           </div>

        </div>
      </div>

    </div>
  </main>
</BaseLayout>


{/* Vanilla JS for Monthly / Yearly Toggle */}
<script>
  document.addEventListener('DOMContentLoaded', () => {
    const toggleBtn = document.getElementById('billing-toggle');
    const toggleCircle = document.getElementById('toggle-circle');
    const labelMonthly = document.getElementById('label-monthly');
    const labelYearly = document.getElementById('label-yearly');
    
    const priceElements = document.querySelectorAll('.price-val');
    const periodElements = document.querySelectorAll('.price-period');
    
    let isYearly = false;

    if (toggleBtn) {
      toggleBtn.addEventListener('click', () => {
        isYearly = !isYearly;
        
        // 1. Animate Toggle Switch
        if (isYearly) {
          toggleBtn.classList.remove('bg-gray-300');
          toggleBtn.classList.add('bg-blue-600');
          toggleCircle?.classList.remove('translate-x-0');
          toggleCircle?.classList.add('translate-x-5');
          
          labelMonthly?.classList.replace('text-gray-900', 'text-gray-500');
          labelMonthly?.classList.replace('font-bold', 'font-semibold');
          labelYearly?.classList.replace('text-gray-500', 'text-gray-900');
          labelYearly?.classList.replace('font-semibold', 'font-bold');
        } else {
          toggleBtn.classList.remove('bg-blue-600');
          toggleBtn.classList.add('bg-gray-300');
          toggleCircle?.classList.remove('translate-x-5');
          toggleCircle?.classList.add('translate-x-0');
          
          labelYearly?.classList.replace('text-gray-900', 'text-gray-500');
          labelYearly?.classList.replace('font-bold', 'font-semibold');
          labelMonthly?.classList.replace('text-gray-500', 'text-gray-900');
          labelMonthly?.classList.replace('font-semibold', 'font-bold');
        }

        // 2. Update Prices & Text
        priceElements.forEach((el) => {
          const newPrice = isYearly ? el.getAttribute('data-yearly') : el.getAttribute('data-monthly');
          if (newPrice) el.textContent = newPrice;
        });

        periodElements.forEach((el) => {
          el.textContent = isYearly ? '/yr' : '/mo';
        });
      });
    }
  });
</script>