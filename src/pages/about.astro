---
import BaseLayout from '../layouts/BaseLayout.astro';
import CheckIcon from '../components/CheckIcon.astro';

const title = "About Us | Everyday Intelligence";
const description = "Learn about the mission, team, and technology behind SELL EVERYDAY. We're building the future of offline-first retail technology.";
---

<BaseLayout title={title} description={description}>
  
  {/* --- HEADER / NAVIGATION --- */}

  <main>
    {/* --- HERO SECTION --- */}
    <div class="relative isolate overflow-hidden bg-white px-6 py-24 sm:py-32 lg:px-8">
      <div class="absolute inset-0 -z-10 bg-[radial-gradient(45rem_50rem_at_top,theme(colors.blue.50),white)] opacity-20"></div>
      <div class="mx-auto max-w-2xl text-center pt-16">
        <h2 class="text-base font-semibold leading-7 text-blue-600">Our Story</h2>
        <p class="mt-2 text-4xl font-bold tracking-tight text-gray-900 sm:text-6xl">Empowering Retailers Everywhere</p>
        <p class="mt-6 text-lg leading-8 text-gray-600">We believe that every business owner, regardless of their location or internet stability, deserves access to world-class retail technology.</p>
      </div>
    </div>

    {/* --- MISSION SECTION --- */}
    <div class="bg-white py-24 sm:py-32">
      <div class="mx-auto max-w-7xl px-6 lg:px-8">
        <div class="mx-auto grid max-w-2xl grid-cols-1 gap-x-8 gap-y-16 sm:gap-y-20 lg:mx-0 lg:max-w-none lg:grid-cols-2 lg:items-center">
          <div class="lg:pr-8 lg:pt-4">
            <div class="lg:max-w-lg">
              <h2 class="text-base font-semibold leading-7 text-blue-600">Our Mission</h2>
              <p class="mt-2 text-3xl font-bold tracking-tight text-gray-900 sm:text-4xl">Bridging the Connectivity Gap</p>
              <p class="mt-6 text-lg leading-8 text-gray-600">
                SELL EVERYDAY was born out of a simple observation: modern cloud software is amazing, but it fails when the internet drops. In many parts of the world, "cloud-only" is "broken-often."
              </p>
              <p class="mt-4 text-lg leading-8 text-gray-600">
                We set out to build an offline-first architecture that gives retailers the reliability of a local legacy system with the power and analytics of a modern cloud platform.
              </p>
              <dl class="mt-10 max-w-xl space-y-8 text-base leading-7 text-gray-600 lg:max-w-none">
                <div class="relative pl-9">
                  <dt class="inline font-semibold text-gray-900">
                    <div class="absolute left-0 top-1">
                      <svg class="h-5 w-5 text-blue-600" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                        <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.857-9.809a.75.75 0 00-1.214-.882l-3.483 4.79-1.88-1.88a.75.75 0 10-1.06 1.061l2.5 2.5a.75.75 0 001.137-.089l4-5.5z" clip-rule="evenodd" />
                      </svg>
                    </div>
                    Inclusion.
                  </dt>
                  <dd class="inline">Tools for every business, from street kiosks to multi-branch supermarkets.</dd>
                </div>
                <div class="relative pl-9">
                  <dt class="inline font-semibold text-gray-900">
                    <div class="absolute left-0 top-1">
                      <svg class="h-5 w-5 text-blue-600" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                        <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.857-9.809a.75.75 0 00-1.214-.882l-3.483 4.79-1.88-1.88a.75.75 0 10-1.06 1.061l2.5 2.5a.75.75 0 001.137-.089l4-5.5z" clip-rule="evenodd" />
                      </svg>
                    </div>
                    Reliability.
                  </dt>
                  <dd class="inline">Software that works as hard as you do, even when the power is out.</dd>
                </div>
              </dl>
            </div>
          </div>
          <div class="flex items-start justify-end lg:order-first">
            <img src="https://images.unsplash.com/photo-1521737604893-d14cc237f11d?ixlib=rb-4.0.3&auto=format&fit=crop&w=1587&q=80" alt="Team working" class="w-[48rem] max-w-none rounded-xl shadow-xl ring-1 ring-gray-400/10 sm:w-[57rem]" width="2432" height="1442" />
          </div>
        </div>
      </div>
    </div>

    {/* --- VALUES SECTION --- */}
    <div class="bg-gray-900 py-24 sm:py-32">
      <div class="mx-auto max-w-7xl px-6 lg:px-8">
        <div class="mx-auto max-w-2xl lg:mx-0">
          <h2 class="text-3xl font-bold tracking-tight text-white sm:text-4xl">Our Values</h2>
          <p class="mt-6 text-lg leading-8 text-gray-300">We guide our decisions based on these core principles that put our customers first.</p>
        </div>
        <dl class="mx-auto mt-16 grid max-w-2xl grid-cols-1 gap-x-8 gap-y-16 text-base leading-7 sm:grid-cols-2 lg:mx-0 lg:max-w-none lg:grid-cols-3">
          <div>
            <dt class="font-semibold text-white">Transparency</dt>
            <dd class="mt-1 text-gray-400">We are open about our pricing, our technology, and our roadmap. No hidden fees, no surprises.</dd>
          </div>
          <div>
            <dt class="font-semibold text-white">Innovation</dt>
            <dd class="mt-1 text-gray-400">We push the boundaries of what's possible in offline-first sync technology.</dd>
          </div>
          <div>
            <dt class="font-semibold text-white">Security</dt>
            <dd class="mt-1 text-gray-400">Your data is your most valuable asset. We use bank-grade encryption to keep it safe.</dd>
          </div>
        </dl>
      </div>
    </div>

    {/* --- STATS SECTION --- */}
    <div class="bg-white py-24 sm:py-32">
      <div class="mx-auto max-w-7xl px-6 lg:px-8">
        <div class="mx-auto max-w-2xl lg:max-w-none">
          <div class="text-center">
            <h2 class="text-3xl font-bold tracking-tight text-gray-900 sm:text-4xl">Trusted by thousands of businesses</h2>
            <p class="mt-4 text-lg leading-8 text-gray-600">Our platform scales with your growth, from one store to hundreds.</p>
          </div>
          <dl class="mt-16 grid grid-cols-1 gap-0.5 overflow-hidden rounded-2xl text-center sm:grid-cols-2 lg:grid-cols-4">
            <div class="flex flex-col bg-gray-400/5 p-8">
              <dt class="text-sm font-semibold leading-6 text-gray-600">Active Branches</dt>
              <dd class="order-first text-3xl font-bold tracking-tight text-gray-900">2,500+</dd>
            </div>
            <div class="flex flex-col bg-gray-400/5 p-8">
              <dt class="text-sm font-semibold leading-6 text-gray-600">Daily Transactions</dt>
              <dd class="order-first text-3xl font-bold tracking-tight text-gray-900">500k+</dd>
            </div>
            <div class="flex flex-col bg-gray-400/5 p-8">
              <dt class="text-sm font-semibold leading-6 text-gray-600">Uptime</dt>
              <dd class="order-first text-3xl font-bold tracking-tight text-gray-900">99.9%</dd>
            </div>
            <div class="flex flex-col bg-gray-400/5 p-8">
              <dt class="text-sm font-semibold leading-6 text-gray-600">Support Satisfaction</dt>
              <dd class="order-first text-3xl font-bold tracking-tight text-gray-900">4.9/5</dd>
            </div>
          </dl>
        </div>
      </div>
    </div>

    {/* --- CTA SECTION --- */}
    <div class="bg-blue-600">
      <div class="px-6 py-24 sm:px-6 sm:py-32 lg:px-8">
        <div class="mx-auto max-w-2xl text-center">
          <h2 class="text-3xl font-bold tracking-tight text-white sm:text-4xl">Ready to join the revolution?</h2>
          <p class="mx-auto mt-6 max-w-xl text-lg leading-8 text-blue-100">Start your journey with SELL EVERYDAY today and experience the power of offline-first retail technology.</p>
          <div class="mt-10 flex items-center justify-center gap-x-6">
            <a href="https://app.sell-everyday-pos.app/register" class="rounded-md bg-white px-3.5 py-2.5 text-sm font-semibold text-blue-600 shadow-sm hover:bg-blue-50 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white transition">Get started</a>
            <a href="/pricing" class="text-sm font-semibold leading-6 text-white">View pricing <span aria-hidden="true">→</span></a>
          </div>
        </div>
      </div>
    </div>
  </main>

  {/* --- FOOTER --- */}

</BaseLayout>



