---
import BaseLayout from '../layouts/BaseLayout.astro';

const title = "Contact Us | SELL EVERYDAY";
const description = "Get in touch with our sales and support teams.";
---

<BaseLayout title={title} description={description}>
  <main class="py-24 sm:py-32 bg-gray-50 min-h-screen">
    <div class="mx-auto max-w-7xl px-6 lg:px-8">
      
      {/* Title Section */}
      <div class="mx-auto max-w-2xl text-center mb-16">
        <h1 class="text-4xl font-bold tracking-tight text-gray-900 sm:text-5xl">Contact Us</h1>
        <p class="mt-4 text-lg leading-8 text-gray-600">
          Whether you're looking to upgrade to our Enterprise plan or need help with your current setup, we're here for you.
        </p>
      </div>

      <div class="mx-auto max-w-5xl">
        <div class="grid grid-cols-1 gap-8 sm:grid-cols-2 lg:grid-cols-3">
          
          {/* Sales Email */}
          <div class="bg-white rounded-3xl p-8 shadow-sm ring-1 ring-gray-900/5 hover:shadow-md transition text-center flex flex-col items-center">
            <div class="h-14 w-14 rounded-2xl bg-blue-50 flex items-center justify-center mb-6 text-blue-600">
              <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" /></svg>
            </div>
            <h3 class="text-lg font-bold text-gray-900 mb-2">Sales Inquiries</h3>
            <p class="text-gray-500 text-sm mb-4">Looking to buy or need a custom license? Reach out to our sales team.</p>
            <a href="mailto:sales@sell-everyday-pos.app" class="text-blue-600 font-bold hover:text-blue-800">sales@sell-everyday-pos.app</a>
          </div>

          {/* Support Email */}
          <div class="bg-white rounded-3xl p-8 shadow-sm ring-1 ring-gray-900/5 hover:shadow-md transition text-center flex flex-col items-center">
            <div class="h-14 w-14 rounded-2xl bg-green-50 flex items-center justify-center mb-6 text-green-600">
              <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18.364 5.636l-3.536 3.536m0 5.656l3.536 3.536M9.172 9.172L5.636 5.636m3.536 9.192l-3.536 3.536M21 12a9 9 0 11-18 0 9 9 0 0118 0zm-5 0a4 4 0 11-8 0 4 4 0 018 0z" /></svg>
            </div>
            <h3 class="text-lg font-bold text-gray-900 mb-2">Customer Support</h3>
            <p class="text-gray-500 text-sm mb-4">Need help setting up your POS or troubleshooting? We've got your back.</p>
            <a href="mailto:support@sell-everyday-pos.app" class="text-green-600 font-bold hover:text-green-800">support@sell-everyday-pos.app</a>
          </div>

          {/* Phone Number */}
          <div class="bg-white rounded-3xl p-8 shadow-sm ring-1 ring-gray-900/5 hover:shadow-md transition text-center flex flex-col items-center">
            <div class="h-14 w-14 rounded-2xl bg-purple-50 flex items-center justify-center mb-6 text-purple-600">
              <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" /></svg>
            </div>
            <h3 class="text-lg font-bold text-gray-900 mb-2">Give Us a Call</h3>
            <p class="text-gray-500 text-sm mb-4">Want to talk to a human? Call us during business hours.</p>
            <a href="tel:+2348100053846" class="text-purple-600 font-bold hover:text-purple-800">+234 81000 53846</a>
          </div>

        </div>
      </div>
      
    </div>
  </main>
</BaseLayout>
