---
import BaseLayout from '../layouts/BaseLayout.astro';

// SEO Metadata for the homepage
const title = "Cloud POS System for Multi-Branch Retail";
const description = "Run your retail empire without relying on the internet. SELL EVERYDAY is the offline-first cloud point of sale built for modern businesses. Track inventory, manage debt, and view real-time analytics.";
---

<BaseLayout title={title} description={description}>
  
  {/* --- HEADER / NAVIGATION --- */}

  {/* --- HERO SECTION --- */}
  <div class="relative isolate pt-14 overflow-hidden bg-white">
    <div class="absolute inset-x-0 -top-40 -z-10 transform-gpu overflow-hidden blur-3xl sm:-top-80" aria-hidden="true">
      <div class="relative left-[calc(50%-11rem)] aspect-[1155/678] w-[36.125rem] -translate-x-1/2 rotate-[30deg] bg-gradient-to-tr from-[#ff80b5] to-[#9089fc] opacity-30 sm:left-[calc(50%-30rem)] sm:w-[72.1875rem]" style="clip-path: polygon(74.1% 44.1%, 100% 61.6%, 97.5% 26.9%, 85.5% 0.1%, 80.7% 2%, 72.5% 32.5%, 60.2% 62.4%, 52.4% 68.1%, 47.5% 58.3%, 45.2% 34.5%, 27.5% 76.7%, 0.1% 64.9%, 17.9% 100%, 27.6% 76.8%, 76.1% 97.7%, 74.1% 44.1%)"></div>
    </div>
    
    <div class="py-24 sm:py-32 lg:pb-40">
      <div class="mx-auto max-w-7xl px-6 lg:px-8">
        <div class="mx-auto max-w-2xl text-center">
          <div class="mb-8 flex justify-center">
            <span class="relative rounded-full px-3 py-1 text-sm leading-6 text-gray-600 ring-1 ring-gray-900/10 hover:ring-gray-900/20">
              Announcing our new Offline-First engine. <a href="/blog/welcome" class="font-semibold text-blue-600"><span class="absolute inset-0" aria-hidden="true"></span>Read more <span aria-hidden="true">&rarr;</span></a>
            </span>
          </div>
          <h1 class="text-4xl font-bold tracking-tight text-gray-900 sm:text-6xl">
            Run your retail empire without relying on the internet.
          </h1>
          <p class="mt-6 text-lg leading-8 text-gray-600">
            The cloud POS built for modern businesses. Keep selling when the WiFi drops, manage multiple branches, and track customer debt with military precision.
          </p>
          <div class="mt-10 flex items-center justify-center gap-x-6">
            <a href="https://app.sell-everyday-pos.app/register" class="rounded-xl bg-blue-600 px-6 py-3.5 text-sm font-semibold text-white shadow-sm hover:bg-blue-500 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-600 transition-all hover:scale-105">
              Start your 14-day free trial
            </a>
            <a href="/demo" class="group text-sm font-semibold leading-6 text-gray-900 hover:text-blue-600 flex items-center gap-2 transition-colors">
              <svg class="h-6 w-6 text-blue-600 group-hover:text-blue-500 transition-colors" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path fill-rule="evenodd" d="M2.25 12c0-5.385 4.365-9.75 9.75-9.75s9.75 4.365 9.75 9.75-4.365 9.75-9.75 9.75S2.25 17.385 2.25 12zm14.024-.983a1.125 1.125 0 010 1.966l-5.603 3.113A1.125 1.125 0 019 15.113V8.887c0-.857.921-1.4 1.671-.983l5.603 3.113z" clip-rule="evenodd" />
              </svg>
              Watch demo
            </a>
          </div>
        </div>
        
        {/* Dashboard Mockup Image */}
        <div class="mt-16 flow-root sm:mt-24">
          <div class="-m-2 rounded-xl bg-gray-900/5 p-2 ring-1 ring-inset ring-gray-900/10 lg:-m-4 lg:rounded-2xl lg:p-4">
            <img src="/images/dashboard-mockup.png" alt="SELL EVERYDAY Dashboard" width="2432" height="1442" class="rounded-md shadow-2xl ring-1 ring-gray-900/10 md:rounded-xl" onerror="this.src='https://placehold.co/2432x1442/f3f4f6/6b7280?text=Dashboard+Screenshot'" />
          </div>
        </div>
      </div>
    </div>
  </div>

  {/* --- FEATURES GRID --- */}
  <div class="bg-gray-50 py-24 sm:py-32">
    <div class="mx-auto max-w-7xl px-6 lg:px-8">
      <div class="mx-auto max-w-2xl lg:text-center">
        <h2 class="text-base font-semibold leading-7 text-blue-600">Sell Faster</h2>
        <p class="mt-2 text-3xl font-bold tracking-tight text-gray-900 sm:text-4xl">Everything you need to scale your store</p>
        <p class="mt-6 text-lg leading-8 text-gray-600">We built SELL EVERYDAY to solve the real problems of retail. No more lost sales due to bad internet, and no more unrecorded customer debts.</p>
      </div>
      
      <div class="mx-auto mt-16 max-w-2xl sm:mt-20 lg:mt-24 lg:max-w-none">
        <dl class="grid max-w-xl grid-cols-1 gap-x-8 gap-y-16 lg:max-w-none lg:grid-cols-3">
          
          {/* Feature 1 */}
          <div class="flex flex-col bg-white p-8 rounded-2xl shadow-sm border border-gray-100">
            <dt class="flex items-center gap-x-3 text-base font-semibold leading-7 text-gray-900">
              <div class="h-10 w-10 flex items-center justify-center rounded-lg bg-blue-600">
                <svg class="h-6 w-6 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18.364 5.636l-3.536 3.536m0 5.656l3.536 3.536M9.172 9.172L5.636 5.636m3.536 9.192l-3.536 3.536M21 12a9 9 0 11-18 0 9 9 0 0118 0zm-5 0a4 4 0 11-8 0 4 4 0 018 0z" /></svg>
              </div>
              100% Offline-First
            </dt>
            <dd class="mt-4 flex flex-auto flex-col text-base leading-7 text-gray-600">
              <p class="flex-auto">Internet goes down? Your checkout doesn't. Process sales offline and SELL EVERYDAY will automatically sync everything to the cloud the moment your connection returns.</p>
            </dd>
          </div>

          {/* Feature 2 */}
          <div class="flex flex-col bg-white p-8 rounded-2xl shadow-sm border border-gray-100">
            <dt class="flex items-center gap-x-3 text-base font-semibold leading-7 text-gray-900">
              <div class="h-10 w-10 flex items-center justify-center rounded-lg bg-blue-600">
                <svg class="h-6 w-6 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" /></svg>
              </div>
              Multi-Branch Control
            </dt>
            <dd class="mt-4 flex flex-auto flex-col text-base leading-7 text-gray-600">
              <p class="flex-auto">Manage inventory, adjust branch-specific pricing, and view consolidated financial reports for all your locations from a single admin dashboard.</p>
            </dd>
          </div>

          {/* Feature 3 */}
          <div class="flex flex-col bg-white p-8 rounded-2xl shadow-sm border border-gray-100">
            <dt class="flex items-center gap-x-3 text-base font-semibold leading-7 text-gray-900">
              <div class="h-10 w-10 flex items-center justify-center rounded-lg bg-blue-600">
                <svg class="h-6 w-6 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
              </div>
              Debt & Loyalty Engine
            </dt>
            <dd class="mt-4 flex flex-auto flex-col text-base leading-7 text-gray-600">
              <p class="flex-auto">Record partial payments, track credit sales in the customer debt ledger, and reward your best customers with automated loyalty points.</p>
            </dd>
          </div>

        </dl>
      </div>
    </div>
  </div>

  {/* --- CTA SECTION --- */}
  <div class="bg-white">
    <div class="mx-auto max-w-7xl px-6 py-24 sm:py-32 lg:flex lg:items-center lg:justify-between lg:px-8">
      <h2 class="text-3xl font-bold tracking-tight text-gray-900 sm:text-4xl">
        Ready to scale your retail business?<br />
        <span class="text-blue-600">Join hundreds of smart store owners today.</span>
      </h2>
      <div class="mt-10 flex items-center gap-x-6 lg:mt-0 lg:flex-shrink-0">
        <a href="https://app.sell-everyday-pos.app/register" class="rounded-xl bg-blue-600 px-8 py-4 text-base font-semibold text-white shadow-sm hover:bg-blue-500 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-600 transition-all hover:scale-105">
          Get Started Now
        </a>
        <a href="/pricing" class="text-base font-semibold leading-6 text-gray-900 hover:text-blue-600">View pricing <span aria-hidden="true">→</span></a>
      </div>
    </div>
  </div>

  {/* --- FOOTER --- */}

</BaseLayout>

