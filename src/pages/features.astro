---
import BaseLayout from '../layouts/BaseLayout.astro';

const title = "Features | SELL EVERYDAY";
const description = "Explore the ultimate retail toolkit: Offline sales, AI insights, Multi-branch syncing, Debt ledgers, and Anti-theft alerts.";
---

<BaseLayout title={title} description={description}>
  {/* Header Navigation */}

  <main class="pt-24 pb-16 sm:pt-32 sm:pb-24 bg-gray-50 min-h-screen">
    {/* Page Title & Tab Selector */}
    <div class="mx-auto max-w-7xl px-6 lg:px-8 text-center mb-12 sm:mb-16">
      <h1 class="text-4xl font-bold tracking-tight text-gray-900 sm:text-6xl mb-6">
        Everything you need to scale.
      </h1>
      <p class="text-lg leading-8 text-gray-600 max-w-2xl mx-auto mb-10">
        From AI-powered insights to offline-first checkout engines, discover the tools built to protect your revenue and simplify your operations.
      </p>

      {/* Deployment Tabs (Cloud vs License) */}
      <div class="inline-flex items-center justify-center p-1 bg-gray-200/80 rounded-xl shadow-inner">
        <button 
          id="btn-cloud" 
          class="px-8 py-3 text-sm font-bold rounded-lg transition-all duration-200 bg-white text-blue-600 shadow-sm ring-1 ring-gray-900/5"
        >
          Cloud Hosted (SaaS)
        </button>
        <button 
          id="btn-license" 
          class="px-8 py-3 text-sm font-semibold rounded-lg transition-all duration-200 text-gray-500 hover:text-gray-900 hover:bg-gray-100/50"
        >
          On-Premise License
        </button>
      </div>
    </div>

    {/* --- PANEL 1: CLOUD HOSTED (ACTIVE BY DEFAULT) --- */}
    <div id="panel-cloud" class="mx-auto max-w-7xl px-6 lg:px-8 transition-opacity duration-300">
      
      {/* Comprehensive Feature Grid */}
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        
        {/* Mobile App */}
        <div class="bg-white p-8 rounded-2xl shadow-sm border border-gray-100 hover:shadow-md transition">
          <div class="h-12 w-12 rounded-xl bg-blue-50 flex items-center justify-center mb-6">
            <svg class="h-6 w-6 text-blue-600" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z" /></svg>
          </div>
          <h3 class="text-xl font-bold text-gray-900 mb-3">Mobile App & Scanner</h3>
          <p class="text-gray-600 leading-relaxed">Sell directly from the sales floor using the mobile app. Use your phone's camera as a lightning-fast barcode scanner for instant checkouts.</p>
        </div>

        {/* Store AI */}
        <div class="bg-white p-8 rounded-2xl shadow-sm border border-blue-100 ring-1 ring-blue-600/10 hover:shadow-md transition relative overflow-hidden">
          <div class="absolute top-0 right-0 px-3 py-1 bg-gradient-to-r from-purple-600 to-blue-600 text-white text-[10px] font-bold rounded-bl-lg uppercase tracking-wider">Powered by AI</div>
          <div class="h-12 w-12 rounded-xl bg-purple-50 flex items-center justify-center mb-6">
            <svg class="h-6 w-6 text-purple-600" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" /></svg>
          </div>
          <h3 class="text-xl font-bold text-gray-900 mb-3">Store AI Assistant</h3>
          <p class="text-gray-600 leading-relaxed">Chat with your data. Ask your AI to summarize daily sales, identify slow-moving stock, or even generate product descriptions automatically.</p>
        </div>

        {/* Offline/Online Sales */}
        <div class="bg-white p-8 rounded-2xl shadow-sm border border-gray-100 hover:shadow-md transition">
          <div class="h-12 w-12 rounded-xl bg-green-50 flex items-center justify-center mb-6">
            <svg class="h-6 w-6 text-green-600" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg>
          </div>
          <h3 class="text-xl font-bold text-gray-900 mb-3">Hybrid Sales Engine</h3>
          <p class="text-gray-600 leading-relaxed">Process online and offline sales seamlessly. Full support for VAT, variable service charges, promotional coupons, and delivery tracking.</p>
        </div>

        {/* Multi-Branch */}
        <div class="bg-white p-8 rounded-2xl shadow-sm border border-gray-100 hover:shadow-md transition">
          <div class="h-12 w-12 rounded-xl bg-indigo-50 flex items-center justify-center mb-6">
            <svg class="h-6 w-6 text-indigo-600" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" /></svg>
          </div>
          <h3 class="text-xl font-bold text-gray-900 mb-3">Multi-Branch Control</h3>
          <p class="text-gray-600 leading-relaxed">Granular access control. Branch managers see only their specific store's data, while admins get full organizational oversight and control.</p>
        </div>

        {/* Customer Management */}
        <div class="bg-white p-8 rounded-2xl shadow-sm border border-gray-100 hover:shadow-md transition">
          <div class="h-12 w-12 rounded-xl bg-pink-50 flex items-center justify-center mb-6">
            <svg class="h-6 w-6 text-pink-600" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" /></svg>
          </div>
          <h3 class="text-xl font-bold text-gray-900 mb-3">CRM, Debt & Loyalty</h3>
          <p class="text-gray-600 leading-relaxed">Track purchase histories, manage customer debt with partial repayments, and automate retention with a points-based reward system.</p>
        </div>

        {/* Inventory Management */}
        <div class="bg-white p-8 rounded-2xl shadow-sm border border-gray-100 hover:shadow-md transition">
          <div class="h-12 w-12 rounded-xl bg-orange-50 flex items-center justify-center mb-6">
            <svg class="h-6 w-6 text-orange-600" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4" /></svg>
          </div>
          <h3 class="text-xl font-bold text-gray-900 mb-3">Advanced Inventory</h3>
          <p class="text-gray-600 leading-relaxed">Never lose track of a single item. Manage suppliers, generate purchase orders, and execute inter-store stock transfers flawlessly.</p>
        </div>

        {/* Analytics */}
        <div class="bg-white p-8 rounded-2xl shadow-sm border border-gray-100 hover:shadow-md transition">
          <div class="h-12 w-12 rounded-xl bg-teal-50 flex items-center justify-center mb-6">
            <svg class="h-6 w-6 text-teal-600" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H4a2 2 0 00-2 2v6a2 2 0 002 2h3a2 2 0 002-2zm0 0V9a2 2 0 012-2h3a2 2 0 012 2v10m-2 0h2a2 2 0 002-2V9a2 2 0 00-2-2h-3a2 2 0 00-2 2v10a2 2 0 002 2z" /></svg>
          </div>
          <h3 class="text-xl font-bold text-gray-900 mb-3">Deep Analytics</h3>
          <p class="text-gray-600 leading-relaxed">Identify your best-performing products, top employees, and most profitable stores. Get automated low-stock reminders before you run out.</p>
        </div>

        {/* Expenses */}
        <div class="bg-white p-8 rounded-2xl shadow-sm border border-gray-100 hover:shadow-md transition">
          <div class="h-12 w-12 rounded-xl bg-red-50 flex items-center justify-center mb-6">
            <svg class="h-6 w-6 text-red-600" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 14l6-6m-5.5.5h.01m4.99 5h.01M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16l3.5-2 3.5 2 3.5-2 3.5 2z" /></svg>
          </div>
          <h3 class="text-xl font-bold text-gray-900 mb-3">Expense Tracking</h3>
          <p class="text-gray-600 leading-relaxed">Keep your P&L accurate. Log both one-time operational costs and set up recurring expenses (like rent or internet) to hit the ledger automatically.</p>
        </div>

        {/* Anti-Theft */}
        <div class="bg-white p-8 rounded-2xl shadow-sm border border-gray-100 hover:shadow-md transition">
          <div class="h-12 w-12 rounded-xl bg-gray-800 flex items-center justify-center mb-6">
            <svg class="h-6 w-6 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" /></svg>
          </div>
          <h3 class="text-xl font-bold text-gray-900 mb-3">Anti-Theft Auditing</h3>
          <p class="text-gray-600 leading-relaxed">Protect your margins. The system tracks every action and alerts admins immediately of fraudulent price overrides or suspicious quantity adjustments.</p>
        </div>

      </div>
    </div>

    {/* --- PANEL 2: ON-PREMISE LICENSE (HIDDEN BY DEFAULT) --- */}
    <div id="panel-license" class="hidden mx-auto max-w-3xl px-6 lg:px-8 text-center transition-opacity duration-300">
      <div class="bg-white rounded-3xl p-12 shadow-xl ring-1 ring-gray-900/5 mt-8">
        <div class="h-20 w-20 mx-auto bg-gray-50 rounded-full flex items-center justify-center mb-6 border border-gray-100">
          <svg class="h-10 w-10 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 002-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" /></svg>
        </div>
        <h2 class="text-3xl font-bold tracking-tight text-gray-900 mb-4">Enterprise License</h2>
        <div class="inline-flex items-center px-3 py-1 rounded-full text-sm font-bold bg-blue-100 text-blue-700 mb-6 uppercase tracking-wider">
          Coming Soon
        </div>
        <p class="text-lg text-gray-600 leading-relaxed mb-8">
          We are currently developing a self-hosted, on-premise licensing model for enterprise clients who require total data sovereignty and air-gapped deployments.
        </p>
        <div class="p-6 bg-gray-50 rounded-xl border border-gray-100 text-left">
          <h4 class="font-bold text-gray-900 mb-2 flex items-center gap-2">
            <svg class="h-5 w-5 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
            What to expect:
          </h4>
          <ul class="space-y-2 text-sm text-gray-600">
            <li class="flex items-center gap-2"><div class="h-1.5 w-1.5 rounded-full bg-blue-600"></div> Host on your own private servers (AWS, Local Network)</li>
            <li class="flex items-center gap-2"><div class="h-1.5 w-1.5 rounded-full bg-blue-600"></div> One-time perpetual license fee</li>
            <li class="flex items-center gap-2"><div class="h-1.5 w-1.5 rounded-full bg-blue-600"></div> Priority SLA & Dedicated Account Manager</li>
            <li class="flex items-center gap-2"><div class="h-1.5 w-1.5 rounded-full bg-blue-600"></div> Custom White-labeling (Your Logo & Brand Colors)</li>
          </ul>
        </div>
        <div class="mt-8">
          <a href="mailto:enterprise@yourdomain.com" class="text-blue-600 font-bold hover:text-blue-800 underline underline-offset-4">Contact Sales to join the waitlist</a>
        </div>
      </div>
    </div>

  {/* --- FOOTER --- */}

  </main>
</BaseLayout>

{/* Vanilla JS for Tab Switching */}
<script>
  document.addEventListener('DOMContentLoaded', () => {
    const btnCloud = document.getElementById('btn-cloud');
    const btnLicense = document.getElementById('btn-license');
    const panelCloud = document.getElementById('panel-cloud');
    const panelLicense = document.getElementById('panel-license');

    // CSS Classes for Active vs Inactive Tabs
    const activeClasses = ['bg-white', 'text-blue-600', 'shadow-sm', 'ring-1', 'ring-gray-900/5', 'font-bold'];
    const inactiveClasses = ['text-gray-500', 'hover:text-gray-900', 'hover:bg-gray-100/50', 'font-semibold'];

    const setTab = (tab: 'cloud' | 'license') => {
      if (!btnCloud || !btnLicense || !panelCloud || !panelLicense) return;

      if (tab === 'cloud') {
        // Show Cloud, Hide License
        panelCloud.classList.remove('hidden');
        panelLicense.classList.add('hidden');
        
        // Update Buttons
        btnCloud.classList.add(...activeClasses);
        btnCloud.classList.remove(...inactiveClasses);
        
        btnLicense.classList.remove(...activeClasses);
        btnLicense.classList.add(...inactiveClasses);
      } else {
        // Show License, Hide Cloud
        panelLicense.classList.remove('hidden');
        panelCloud.classList.add('hidden');
        
        // Update Buttons
        btnLicense.classList.add(...activeClasses);
        btnLicense.classList.remove(...inactiveClasses);
        
        btnCloud.classList.remove(...activeClasses);
        btnCloud.classList.add(...inactiveClasses);
      }
    };

    // Attach Listeners
    btnCloud?.addEventListener('click', () => setTab('cloud'));
    btnLicense?.addEventListener('click', () => setTab('license'));
  });
</script>


